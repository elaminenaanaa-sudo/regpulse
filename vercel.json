<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>CRegul — Credit Review Regulatory Intelligence</title>
<meta name="description" content="Institutional-grade credit memo compliance scanner. 57 examiner checkpoints from OCC, FDIC, and Federal Reserve.">
<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' rx='20' fill='%23002F6C'/><text x='50' y='72' text-anchor='middle' font-size='64' font-weight='900' fill='white'>C</text></svg>">
<script src="https://cdnjs.cloudflare.com/ajax/libs/react/18.2.0/umd/react.production.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/react-dom/18.2.0/umd/react-dom.production.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/babel-standalone/7.23.9/babel.min.js"></script>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{font-family:'IBM Plex Sans',sans-serif;background:#0A1628;color:#C5D0DC;-webkit-font-smoothing:antialiased;font-size:13px}
textarea:focus,button:focus{outline:none}
textarea::placeholder{color:#2D4A6F}
button{cursor:pointer;border:none;background:none;font-family:inherit;color:inherit}
::-webkit-scrollbar{width:6px}::-webkit-scrollbar-track{background:#0A1628}::-webkit-scrollbar-thumb{background:#1E3A5F;border-radius:3px}
</style>
</head>
<body>
<div id="root"></div>
<script type="text/babel">
const{useState,useCallback,useRef,useEffect}=React;
const C={bg:"#0A1628",sf:"#0F1D32",cd:"#132337",bd:"#1A3050",bdL:"#213D5E",tx:"#C5D0DC",txM:"#5F7A95",txD:"#3A5775",wh:"#E8ECF1",br:"#0EA5E9",brD:"#0C4A6E",gn:"#10B981",gnB:"#052E1C",gnBd:"#064E2B",rd:"#EF4444",rdB:"#2A0A0A",rdBd:"#5C1515",am:"#F59E0B",amB:"#2A1E05",amBd:"#5C4215",nv:"#002F6C"};
const mono="'IBM Plex Mono',monospace";

const S=[
{id:"cf",t:"Cash Flow & Repayment Analysis",ti:1,c:"CF",rg:"OCC Comptroller's Handbook — Rating Credit Risk; FDIC MRBA Data",
sr:"OCC 'Rating Credit Risk' (2001/2012): examiners focus on future debt service ability. FDIC Supervisory Trends: 75%+ of loan MRBAs cite missing cash flow analyses.",
w:"#1 citation reason. OCC mandates forward-looking cash flow. FDIC found this in 75%+ of loan MRBAs.",
ch:[{l:"Historical cash flow (3–5yr trend)",kw:["cash flow","historical","trend","operating cash","ebitda","free cash flow","fcf"],wt:3},{l:"Forward-looking projections",kw:["projected","projection","forecast","pro forma","forward-looking","prospective","budget"],wt:3},{l:"Debt Service Coverage Ratio",kw:["dscr","debt service coverage","debt service","coverage ratio","fixed charge"],wt:3},{l:"Global cash flow (guarantor)",kw:["global cash flow","guarantor","affiliate","combined cash flow","personal cash flow","pfs","personal financial"],wt:2},{l:"Stress / sensitivity scenario",kw:["sensitivity","stress","scenario","downside","adverse case","worst case","base case"],wt:2}]},
{id:"rr",t:"Risk Rating & Classification",ti:1,c:"RR",rg:"OCC Rating Credit Risk; Interagency Classification Standards (BC-127)",
sr:"OCC 'Rating Credit Risk': defines Special Mention, Substandard, Doubtful, Loss. OCC SNC Appeal Q3 2021: downgraded for unsupported rating.",
w:"Examiners re-rate independently. Grade inflation triggers Material Findings.",
ch:[{l:"Risk rating explicitly stated",kw:["risk rating","risk grade","rated","pass","watch","special mention","substandard","doubtful","loss","criticized","classified","grade"],wt:3},{l:"Rating justified by analysis",kw:["rating justified","rating based on","supports a rating","consistent with","warrants","rating reflects","rating is supported","analysis supports"],wt:3},{l:"Rating migration documented",kw:["upgrade","downgrade","migration","rating change","previously rated","changed from","moved from","prior rating"],wt:2},{l:"Accrual status assessed",kw:["accrual","non-accrual","nonaccrual","non-performing","nonperforming","npl","past due"],wt:2}]},
{id:"cv",t:"Collateral Valuation & LTV/LGD",ti:1,c:"CV",rg:"Interagency Appraisal Guidelines; OCC Bulletin 2010-42",
sr:"Interagency Guidelines (OCC 2010-42): current, independent, USPAP-compliant. SNC Appeal Q3 2021: 0.90X–1.03X coverage = Substandard.",
w:"Stale appraisals are the easiest enforcement trigger. SNC appeals cite marginal collateral as a key downgrade factor.",
ch:[{l:"Appraisal / valuation referenced",kw:["appraisal","valuation","appraised value","market value","collateral value","assessed value","evaluation"],wt:3},{l:"Appraisal date documented",kw:["appraisal date","dated","effective date","most recent appraisal","updated appraisal","appraisal completed"],wt:3},{l:"LTV / LTC ratio",kw:["ltv","loan-to-value","loan to value","ltc","loan-to-cost","loan to cost"],wt:3},{l:"LGD estimate",kw:["lgd","loss given default","loss severity","recovery rate","expected loss","recovery estimate"],wt:2},{l:"Collateral haircut applied",kw:["haircut","discount","advance rate","collateral coverage","liquidation value","orderly liquidation","forced sale"],wt:2},{l:"Lien position described",kw:["first lien","second lien","senior","subordinat","ucc","mortgage","pledge","assignment","security interest","secured by"],wt:2}]},
{id:"al",t:"CECL / Allowance Adequacy",ti:1,c:"AL",rg:"ASC 326 (CECL); OCC Bulletin 2006-47; FDIC MRBA Data",
sr:"ASC 326: lifetime loss estimation. FDIC: 28% of loan MRBAs cite unsupported allowance. OCC Appeal Q3 2022: ALLL not supported by sound methodology.",
w:"28% of loan MRBAs involve unsupported allowance. Consent orders found ALLL lacking impairment analyses.",
ch:[{l:"Allowance / reserve discussed",kw:["allowance","reserve","acl","alll","provision","loss reserve","credit loss","expected loss"],wt:3},{l:"Probability of Default (PD)",kw:["probability of default","pd","default probability","likelihood of default"],wt:2},{l:"Exposure at Default (EAD)",kw:["ead","exposure at default","total exposure","committed exposure","outstanding balance","unfunded"],wt:2},{l:"Impairment analysis",kw:["impairment","impaired","specific reserve","individual assessment","asc 326","asc 310","fas 114"],wt:2},{l:"Qualitative / economic factors",kw:["qualitative","q-factor","economic outlook","economic condition","macro","environment","industry condition"],wt:1}]},
{id:"cm",t:"Covenant Monitoring & Compliance",ti:2,c:"CM",rg:"OCC Leveraged Lending; Fed SR 21-19",
sr:"OCC Leveraged Lending (2008): examine covenant compliance. Fed SR 21-19 (Archegos). SNC Appeal Q3 2021: covenant breach = downgrade.",
w:"Repeated waivers without downgrade = masking deterioration. SNC appeals cite covenant breaches as primary drivers.",
ch:[{l:"Financial covenants listed",kw:["covenant","financial covenant","leverage ratio","leverage covenant","minimum","maximum","net worth","tangible net worth"],wt:3},{l:"Compliance status documented",kw:["in compliance","compliant","covenant compliance","breach","violation","met","not met","satisfied","failed","default"],wt:3},{l:"Waivers documented",kw:["waiver","waived","amendment","forbearance","modified","covenant relief","consent"],wt:2},{l:"Headroom / cushion analysis",kw:["headroom","cushion","trending","approaching","buffer","covenant trend","margin of"],wt:2}]},
{id:"dp",t:"Documentation & Policy Compliance",ti:2,c:"DP",rg:"OCC Comptroller's Handbook; FDIC MRBA Data",
sr:"FDIC: documentation exceptions in majority of loan MRBAs. 49% of Board/Mgmt MRBAs cite policy non-compliance. OCC Appeal Q1 2018: Credit Presentation MRA.",
w:"Binary test — documents are there or not. 49% of Board/Mgmt MRBAs address policy non-compliance.",
ch:[{l:"Current financials referenced",kw:["financial statement","tax return","balance sheet","income statement","p&l","10-k","10-q","audited","unaudited"],wt:3},{l:"Loan terms documented",kw:["loan agreement","credit agreement","facility","term loan","revolver","line of credit","maturity","interest rate","amortization"],wt:2},{l:"Approval authority shown",kw:["approved by","approval","credit committee","loan committee","board approval","delegated authority","authorized"],wt:2},{l:"Policy exceptions noted",kw:["exception","missing","pending","expired","deficiency","documentation exception","outside policy","variance"],wt:2},{l:"Loan purpose stated",kw:["purpose","use of proceeds","loan purpose","financing purpose","funds will be used","proceeds to"],wt:2}]},
{id:"bi",t:"Borrower & Industry Assessment",ti:2,c:"BI",rg:"OCC Examination Procedures; Fed SR 98-25",
sr:"OCC procedures: assess industry outlook, regulatory framework, technological changes. Fed SR 98-25 (1998/2021).",
w:"Memo without industry context or explicit risk identification is incomplete from examiner perspective.",
ch:[{l:"Industry / sector analysis",kw:["industry","sector","market condition","industry trend","competitive","market dynamic","peer","benchmark"],wt:2},{l:"Management quality assessed",kw:["management","management team","track record","experience","leadership","succession","key person","key man"],wt:2},{l:"Risk factors identified",kw:["risk factor","key risk","primary risk","concern","headwind","challenge","threat","vulnerability","weakness"],wt:2},{l:"Mitigants documented",kw:["mitigant","mitigating","offset","compensating","strength","favorable","positive factor","safeguard"],wt:2}]},
{id:"cr",t:"Concentration Risk",ti:2,c:"CR",rg:"OCC Bulletin 2006-46; Interagency CRE Guidance",
sr:"OCC 2006-46: 300%/100% CRE thresholds. OCC Appeal Q3 2022: missing written analysis, sublimits, stress tests.",
w:"Real OCC enforcement: bank policy lacked concentration analysis, sublimits, and portfolio stress tests.",
ch:[{l:"Concentration risk flagged",kw:["concentration","single name","large exposure","% of capital","percent of capital","legal lending limit"],wt:2},{l:"Sector concentration noted",kw:["industry concentration","sector concentration","portfolio concentration","segment exposure"],wt:2},{l:"Geographic risk considered",kw:["geographic","regional","local market","market","location risk"],wt:1}]},
{id:"st",t:"Stress Testing & Scenarios",ti:2,c:"ST",rg:"OCC Comptroller's Handbook; Dodd-Frank DFAST",
sr:"OCC: stress test debt service and collateral. Examiners emphasized at Abrigo conference. Dodd-Frank §165(i).",
w:"Base-case-only memo is a gap. Examiners expect adverse scenarios on DSCR, collateral, and rates.",
ch:[{l:"DSCR stress scenario",kw:["stress test","stressed dscr","sensitivity analysis","stressed case","downside scenario","adverse"],wt:2},{l:"Collateral value stress",kw:["collateral stress","value decline","ltv stress","property value decline"],wt:2},{l:"Interest rate shock",kw:["rate shock","rate increase","interest rate risk","rate sensitivity","rising rate","higher rate"],wt:2},{l:"Revenue decline scenario",kw:["revenue decline","earnings decline","sales decline","margin compression","worst case"],wt:2}]},
{id:"rt",t:"Review Timeliness & Independence",ti:2,c:"RT",rg:"OCC Loan Portfolio Mgmt; FDIC §16.1; Fed SR 94-13",
sr:"OCC Loan Portfolio Mgmt (1998). OCC Consent Order FSGBank (2010): forced review overhaul in 90 days.",
w:"30%+ overdue reviews = control breakdown. Consent orders required full review program overhauls.",
ch:[{l:"Review date documented",kw:["review date","last review","annual review","review completed","credit review","review period"],wt:2},{l:"Review frequency specified",kw:["annual","semi-annual","quarterly","next review","review schedule","review cycle","due for review"],wt:2},{l:"Independent review confirmed",kw:["independent review","credit review","loan review","independent assessment","third-party review","external review"],wt:2}]},
{id:"es",t:"Climate & ESG Risk",ti:3,c:"ES",rg:"OCC Climate Guidance 2023; Fed SR 23-7; TCFD; Basel BCBS",
sr:"OCC Climate Principles (Dec 2023). Fed SR 23-7. TCFD framework. Basel climate risk principles (Jun 2022).",
w:"Emerging. Increasingly expected for carbon-intensive borrowers. Mandatory under Basel/EU for international banks.",
ch:[{l:"Climate / transition risk",kw:["climate","transition risk","physical risk","carbon","emission","esg","environmental","net zero","sustainability"],wt:1},{l:"Governance risk factors",kw:["social","governance","labor","human rights","corporate governance","board composition","dei"],wt:1}]},
{id:"wo",t:"Workout & Resolution Plans",ti:3,c:"WO",rg:"FDIC MRBA Data; OCC Consent Orders",
sr:"FDIC: update workout plans on classified assets. OCC: plan alone ≠ upgrade. FDIC Consent Order Alliance Bank (2012).",
w:"Non-pass credits require action plans, timelines, and upgrade conditions. Plan without performance is insufficient.",
ch:[{l:"Action plan for non-pass",kw:["workout","action plan","remediation","exit strategy","risk reduction","resolution","corrective action"],wt:2},{l:"Resolution timeline",kw:["timeline","target date","expected resolution","deadline","completion date","within","by q"],wt:1},{l:"Upgrade conditions specified",kw:["conditions for upgrade","upgrade criteria","return to pass","upgrade path","requirements to upgrade"],wt:1}]}
];

const TC=S.reduce((a,s)=>a+s.ch.length,0);

const SAMPLE=`CREDIT REVIEW MEMORANDUM — Annual Review\nDate: March 15, 2026 | Prepared by: J. Thompson, VP | Approved by: Credit Committee\n\nBORROWER: Midwest Industrial Holdings LLC\nFACILITY: $12.5M Term Loan + $3M Revolver | MATURITY: Jun 2028 | RATE: SOFR+275bps\nPURPOSE: Acquisition financing and working capital\nRISK RATING: 4 — Pass-Watch (downgraded from 3, Q3 2025). Rating reflects declining cash flow, covenant breach, customer concentration. Prior rating no longer supported by financial analysis.\nAccrual Status: Accruing\n\nFINANCIAL ANALYSIS:\nHistorical cash flow trend (3yr): EBITDA $4.2M (2023), $3.8M (2024), $3.1M (2025).\nFree cash flow declined $2.9M to $1.6M. Margin compression in manufacturing.\nProjected 2026 EBITDA: $3.0M-$3.4M. Pro forma DSCR: 1.05x-1.20x.\nDSCR: 1.12x (prior 1.45x). Fixed charge coverage: 0.98x.\nGlobal cash flow incl. guarantor (CEO PFS on file): Combined DSCR 1.35x.\n\nCOLLATERAL:\nFirst lien on assets + RE. Appraisal dated Sep 2024, independent MAI, USPAP. Value $9.2M.\nLTV: 67% RE / 72% blended. LGD: 35%. Haircut: 20% to OLV.\n\nCOVENANT STATUS:\nMin DSCR 1.15x — IN BREACH (actual 1.12x). Waiver: CC approved 03/10/2026.\nMax Leverage 5.0x — COMPLIANT (headroom 0.0x, trending toward breach).\nMin TNW $7.5M — COMPLIANT ($8.2M, cushion $700K).\n\nINDUSTRY: Manufacturing headwinds — tariffs, inflation. #4 regional.\nCustomer concentration: lost 18% revenue. No succession plan.\nRisk factors: concentration, margin pressure, commodity exposure.\nMitigants: diversifying base, long-term contracts.\n\nREVIEW: Annual review Mar 2026. Prior: Feb 2025. Interim triggered Sep 2025.\nIndependent credit review confirmed rating.\n\nALLOWANCE: Reserve $187.5K (1.5%). PD: 4.2%. LGD: 35%. EAD: $12.5M.\nExpected loss: $183.75K. Qualitative factors: uncertain outlook.\n\nSTRESS: Adverse: 15% revenue decline → DSCR 0.85x, LTV 81%.\nSevere: 25% + rate shock +200bps → DSCR 0.62x.\nCollateral stress: 20% decline → LTV 89%.\n\nPOLICY: Within limits. Exception: DSCR breach CC approved.\nCLIMATE: Moderate transition risk. Flood zone AE, insured.\n\nRECOMMENDATION: Maintain Pass-Watch. Upgrade: DSCR>1.15x 2Q, Lev<4.5x. Next review Sep 2026.`;

function run(tx){const lc=tx.toLowerCase();return S.map(s=>{const r=s.ch.map(c=>({...c,f:c.kw.some(k=>lc.includes(k))}));const tw=r.reduce((a,x)=>a+x.wt,0);const fw=r.filter(x=>x.f).reduce((a,x)=>a+x.wt,0);return{...s,r,sc:tw?fw/tw:0}})}

function Bd({ti}){const m={1:{l:"T1",c:C.rd,b:C.rdB,d:C.rdBd},2:{l:"T2",c:C.am,b:C.amB,d:C.amBd},3:{l:"T3",c:C.br,b:C.brD,d:C.bd}};const v=m[ti];
return <span style={{fontSize:9,fontWeight:700,letterSpacing:.8,padding:"1px 5px",borderRadius:2,background:v.b,color:v.c,border:`1px solid ${v.d}`}}>{v.l}</span>}

function St({ok}){return <span style={{fontSize:9,fontWeight:700,letterSpacing:.5,padding:"1px 6px",borderRadius:2,background:ok?C.gnB:C.rdB,color:ok?C.gn:C.rd,border:`1px solid ${ok?C.gnBd:C.rdBd}`}}>{ok?"PASS":"MISS"}</span>}

function Br({v}){const cl=v>=80?C.gn:v>=50?C.am:C.rd;return <div style={{width:"100%",height:3,borderRadius:1,background:C.bd}}><div style={{width:`${v}%`,height:"100%",borderRadius:1,background:cl,transition:"width .8s ease"}}/></div>}

/* NAV */
function Nav({p,go}){return(
<div style={{background:C.sf,borderBottom:`1px solid ${C.bd}`,display:"flex",alignItems:"center",justifyContent:"space-between",padding:"0 24px",height:46,position:"sticky",top:0,zIndex:100}}>
<div style={{display:"flex",alignItems:"center",gap:16}}>
<div style={{display:"flex",alignItems:"center",gap:8,cursor:"pointer"}} onClick={()=>go("")}>
<div style={{width:22,height:22,borderRadius:3,background:C.nv,display:"flex",alignItems:"center",justifyContent:"center",fontSize:11,fontWeight:700,color:"#fff"}}>C</div>
<span style={{fontSize:13,fontWeight:700,color:C.wh,letterSpacing:.5}}>CREGUL</span></div>
<div style={{width:1,height:18,background:C.bd}}/>
{[["","Overview"],["tool","Scanner"],["methodology","Methodology"]].map(([k,l])=>(
<button key={k} onClick={()=>go(k)} style={{padding:"13px 12px",fontSize:11,fontWeight:600,color:p===k?C.br:C.txM,borderBottom:p===k?`2px solid ${C.br}`:"2px solid transparent"}}>{l}</button>))}
</div>
<span style={{fontSize:9,color:C.txD,fontFamily:mono}}>{TC} CHECKS · v1.0</span>
</div>)}

/* LANDING */
function Pg0({go}){return(
<div style={{maxWidth:840,margin:"0 auto",padding:"0 24px"}}>
<div style={{padding:"48px 0 36px",borderBottom:`1px solid ${C.bd}`}}>
<div style={{display:"flex",alignItems:"center",gap:6,marginBottom:14}}><div style={{width:5,height:5,borderRadius:2,background:C.br}}/><span style={{fontSize:9,fontWeight:700,letterSpacing:2,color:C.br}}>CREDIT REVIEW INTELLIGENCE PLATFORM</span></div>
<h1 style={{fontSize:30,fontWeight:700,color:C.wh,letterSpacing:-.5,lineHeight:1.25,marginBottom:12}}>Identify regulatory gaps before<br/>your examination team does.</h1>
<p style={{fontSize:13,color:C.txM,lineHeight:1.7,maxWidth:540,marginBottom:24}}>CRegul scans credit memoranda against {TC} examiner checkpoints sourced from OCC, FDIC, and Federal Reserve published guidance and real enforcement actions.</p>
<div style={{display:"flex",gap:8}}>
<button onClick={()=>go("tool")} style={{padding:"9px 20px",borderRadius:3,background:C.br,color:"#fff",fontSize:12,fontWeight:600}}>Open Scanner</button>
<button onClick={()=>go("methodology")} style={{padding:"9px 20px",borderRadius:3,border:`1px solid ${C.bd}`,color:C.txM,fontSize:12,fontWeight:600}}>Methodology</button></div></div>

<div style={{display:"grid",gridTemplateColumns:"repeat(4,1fr)",gap:1,background:C.bd,margin:"28px 0",borderRadius:3,overflow:"hidden"}}>
{[[TC+"","Checkpoints","Examiner-grade"],["12","Categories","Regulatory areas"],["3","Regulators","OCC · FDIC · FRB"],["69%","of MRBAs","Cite loan deficiencies"]].map(([n,l,d],i)=>(
<div key={i} style={{background:C.cd,padding:"16px 14px"}}>
<div style={{fontSize:20,fontWeight:700,color:C.wh,fontFamily:mono}}>{n}</div>
<div style={{fontSize:10,fontWeight:600,color:C.txM,marginTop:3}}>{l}</div>
<div style={{fontSize:9,color:C.txD,marginTop:1}}>{d}</div></div>))}</div>

<div style={{background:C.cd,borderRadius:3,border:`1px solid ${C.bd}`,overflow:"hidden",marginBottom:28}}>
<div style={{padding:"10px 14px",borderBottom:`1px solid ${C.bd}`,display:"flex",justifyContent:"space-between"}}>
<span style={{fontSize:9,fontWeight:700,color:C.txD,letterSpacing:1}}>EXAMINATION COVERAGE</span>
<button onClick={()=>go("methodology")} style={{fontSize:10,color:C.br,fontWeight:600}}>Details →</button></div>
<table style={{width:"100%",borderCollapse:"collapse"}}><thead><tr style={{borderBottom:`1px solid ${C.bd}`}}>
{["","Category","Chk","Tier","Primary Source"].map(h=><th key={h} style={{padding:"7px 14px",fontSize:9,fontWeight:700,color:C.txD,textAlign:"left",letterSpacing:.5}}>{h}</th>)}
</tr></thead><tbody>{S.map((s,i)=>(
<tr key={s.id} style={{borderBottom:`1px solid ${C.bd}`,background:i%2?C.sf:"transparent"}}>
<td style={{padding:"8px 14px",fontFamily:mono,fontSize:10,fontWeight:600,color:C.br}}>{s.c}</td>
<td style={{padding:"8px 14px",fontSize:11,fontWeight:500,color:C.wh}}>{s.t}</td>
<td style={{padding:"8px 14px",fontSize:11,fontFamily:mono,color:C.txM}}>{s.ch.length}</td>
<td style={{padding:"8px 14px"}}><Bd ti={s.ti}/></td>
<td style={{padding:"8px 14px",fontSize:9,color:C.txD,maxWidth:180,overflow:"hidden",textOverflow:"ellipsis",whiteSpace:"nowrap"}}>{s.rg.split(";")[0]}</td>
</tr>))}</tbody></table></div>

<div style={{background:C.sf,borderRadius:3,border:`1px solid ${C.bd}`,padding:"18px 20px",display:"flex",justifyContent:"space-between",alignItems:"center"}}>
<div><div style={{fontSize:14,fontWeight:700,color:C.wh}}>Scan your credit memoranda</div><div style={{fontSize:11,color:C.txM,marginTop:2}}>Paste a memo. Receive a compliance assessment in seconds.</div></div>
<button onClick={()=>go("tool")} style={{padding:"9px 20px",borderRadius:3,background:C.br,color:"#fff",fontSize:12,fontWeight:600,whiteSpace:"nowrap"}}>Open Scanner →</button></div>
</div>)}

/* TOOL */
function Pg1({go}){
const[st,setSt]=useState("in");const[tx,setTx]=useState("");const[res,setRes]=useState(null);const[op,setOp]=useState(null);const[inf,setInf]=useState(null);const rf=useRef();
const go2=useCallback(()=>{if(!tx.trim())return;setRes(run(tx));setOp(null);setInf(null);setSt("out");setTimeout(()=>rf.current?.scrollIntoView({behavior:"smooth"}),80)},[tx]);
const ov=res?res.reduce((a,r)=>a+r.sc*(r.ti===1?3:r.ti===2?2:1),0)/res.reduce((a,r)=>a+(r.ti===1?3:r.ti===2?2:1),0):0;
const gaps=res?res.flatMap(s=>s.r.filter(c=>!c.f).map(c=>({sec:s.t,cd:s.c,ti:s.ti,...c}))):[];
const cg=gaps.filter(g=>g.wt>=3);const pc=Math.round(ov*100);

return(
<div ref={rf} style={{maxWidth:840,margin:"0 auto",padding:"0 24px 40px"}}>
{st==="in"&&(<div style={{paddingTop:28}}>
<div style={{marginBottom:16}}><span style={{fontSize:9,fontWeight:700,letterSpacing:2,color:C.br}}>CREDIT MEMO SCANNER</span>
<h2 style={{fontSize:18,fontWeight:700,color:C.wh,marginTop:4}}>Regulatory Compliance Analysis</h2>
<p style={{fontSize:11,color:C.txM,marginTop:3}}>Client-side processing. No data stored or transmitted.</p></div>
<div style={{background:C.cd,borderRadius:3,border:`1px solid ${C.bd}`,padding:14,marginBottom:10}}>
<textarea value={tx} onChange={e=>setTx(e.target.value)} placeholder="Paste credit review memorandum..." style={{width:"100%",minHeight:200,background:"transparent",border:"none",color:C.wh,fontSize:12,fontFamily:mono,lineHeight:1.6,resize:"vertical"}}/></div>
<div style={{display:"flex",gap:8}}>
<button onClick={()=>setTx(SAMPLE)} style={{padding:"9px 14px",borderRadius:3,border:`1px solid ${C.bd}`,color:C.txM,fontSize:11,fontWeight:600}}>Load sample</button>
<button onClick={go2} disabled={!tx.trim()} style={{flex:1,padding:"9px 14px",borderRadius:3,background:tx.trim()?C.br:C.bd,color:tx.trim()?"#fff":C.txD,fontSize:11,fontWeight:600}}>Run Compliance Scan</button></div>
</div>)}

{st==="out"&&res&&(<div style={{paddingTop:20}}>
<div style={{display:"flex",justifyContent:"space-between",alignItems:"center",marginBottom:16}}>
<button onClick={()=>{setSt("in");setRes(null)}} style={{fontSize:10,fontWeight:600,color:C.txM,border:`1px solid ${C.bd}`,borderRadius:3,padding:"5px 10px"}}>← New Scan</button>
<span style={{fontSize:9,color:C.txD,fontFamily:mono}}>{TC} checkpoints evaluated</span></div>

{/* Score */}
<div style={{background:C.cd,borderRadius:3,border:`1px solid ${C.bd}`,padding:"16px 20px",marginBottom:14,display:"flex",alignItems:"center",gap:20}}>
<div style={{width:56,height:56,borderRadius:28,border:`3px solid ${pc>=80?C.gn:pc>=50?C.am:C.rd}`,display:"flex",alignItems:"center",justifyContent:"center",flexShrink:0}}>
<span style={{fontSize:18,fontWeight:700,color:C.wh,fontFamily:mono}}>{pc}</span></div>
<div style={{flex:1}}>
<div style={{fontSize:15,fontWeight:700,color:C.wh}}>{pc>=85?"Strong compliance posture":pc>=70?"Adequate — gaps to address":pc>=50?"Requires attention":"Significant deficiencies"}</div>
<div style={{fontSize:11,color:C.txM,marginTop:2}}>{gaps.length} gap{gaps.length!==1?"s":""} · {cg.length} critical</div>
<div style={{display:"flex",gap:12,marginTop:6}}>
{[{l:"Critical",n:gaps.filter(g=>g.ti===1).length,c:C.rd},{l:"Important",n:gaps.filter(g=>g.ti===2).length,c:C.am},{l:"Emerging",n:gaps.filter(g=>g.ti===3).length,c:C.br}].map(x=>
<span key={x.l} style={{fontSize:10,color:x.n>0?x.c:C.txD}}><span style={{fontFamily:mono,fontWeight:700}}>{x.n}</span> {x.l}</span>)}</div></div></div>

{cg.length>0&&(<div style={{background:C.rdB,borderRadius:3,border:`1px solid ${C.rdBd}`,padding:"10px 14px",marginBottom:14}}>
<div style={{fontSize:9,fontWeight:700,color:C.rd,letterSpacing:.5,marginBottom:6}}>CRITICAL GAPS — HIGH-WEIGHT ITEMS</div>
{cg.map((g,i)=><div key={i} style={{fontSize:11,color:C.rd,padding:"3px 0"}}><span style={{fontFamily:mono,fontSize:9,fontWeight:600,opacity:.6,marginRight:8}}>{g.cd}</span>{g.l}</div>)}</div>)}

{/* Results */}
<div style={{background:C.cd,borderRadius:3,border:`1px solid ${C.bd}`,overflow:"hidden",marginBottom:14}}>
<div style={{padding:"8px 14px",borderBottom:`1px solid ${C.bd}`}}><span style={{fontSize:9,fontWeight:700,color:C.txD,letterSpacing:1}}>SECTION RESULTS</span></div>
{res.map(sec=>{const io=op===sec.id;const f=sec.r.filter(r=>r.f).length;const tt=sec.r.length;const p=Math.round(sec.sc*100);return(
<div key={sec.id} style={{borderBottom:`1px solid ${C.bd}`}}>
<button onClick={()=>setOp(io?null:sec.id)} style={{width:"100%",padding:"10px 14px",display:"flex",alignItems:"center",gap:10,textAlign:"left",background:io?C.sf:"transparent"}}>
<span style={{fontFamily:mono,fontSize:10,fontWeight:700,color:C.br,minWidth:22}}>{sec.c}</span>
<div style={{flex:1}}><div style={{display:"flex",alignItems:"center",gap:6,marginBottom:3}}><span style={{fontSize:11,fontWeight:600,color:C.wh}}>{sec.t}</span><Bd ti={sec.ti}/></div><Br v={p}/></div>
<span style={{fontSize:11,fontFamily:mono,color:p>=80?C.gn:p>=50?C.am:C.rd,fontWeight:600,minWidth:30,textAlign:"right"}}>{p}%</span>
<span style={{fontSize:10,color:C.txD,minWidth:30,textAlign:"right"}}>{f}/{tt}</span>
<span style={{color:C.txD,fontSize:10,marginLeft:4}}>{io?"▾":"▸"}</span></button>
{io&&(<div style={{padding:"0 14px 10px 46px",background:C.sf}}>
<button onClick={()=>setInf(inf===sec.id?null:sec.id)} style={{fontSize:10,color:C.br,fontWeight:600,padding:"4px 0",marginBottom:4}}>{inf===sec.id?"▾":"▸"} Regulatory basis</button>
{inf===sec.id&&<div style={{fontSize:10,color:C.txM,lineHeight:1.6,padding:"6px 10px",background:C.cd,borderRadius:3,border:`1px solid ${C.bd}`,marginBottom:6}}>{sec.w}<br/><span style={{color:C.txD,fontStyle:"italic"}}>{sec.rg}</span></div>}
{sec.r.map(cp=>(<div key={cp.l} style={{display:"flex",alignItems:"center",justifyContent:"space-between",padding:"5px 0",borderTop:`1px solid ${C.bd}`}}>
<div><span style={{fontSize:11,color:cp.f?C.tx:"#EF9A9A"}}>{cp.l}</span><span style={{fontSize:8,color:C.txD,marginLeft:6}}>{"●".repeat(cp.wt)}{"○".repeat(3-cp.wt)}</span></div><St ok={cp.f}/></div>))}</div>)}</div>)})}
</div>

{gaps.length>0&&(<div style={{background:C.cd,borderRadius:3,border:`1px solid ${C.bd}`,overflow:"hidden"}}>
<div style={{padding:"8px 14px",borderBottom:`1px solid ${C.bd}`,display:"flex",justifyContent:"space-between"}}>
<span style={{fontSize:9,fontWeight:700,color:C.txD,letterSpacing:1}}>REMEDIATION QUEUE</span>
<span style={{fontSize:9,color:C.txD,fontFamily:mono}}>{gaps.length} items</span></div>
{gaps.sort((a,b)=>(b.wt*(4-b.ti))-(a.wt*(4-a.ti))).map((g,i)=>(
<div key={i} style={{display:"flex",alignItems:"center",gap:10,padding:"6px 14px",borderBottom:`1px solid ${C.bd}`,background:i%2?C.sf:"transparent"}}>
<span style={{fontSize:9,fontFamily:mono,color:C.txD,minWidth:14}}>{i+1}</span>
<span style={{fontSize:9,fontFamily:mono,color:C.br,fontWeight:600,minWidth:22}}>{g.cd}</span>
<span style={{fontSize:11,color:C.tx,flex:1}}>{g.l}</span><Bd ti={g.ti}/></div>))}</div>)}
{gaps.length===0&&<div style={{background:C.gnB,borderRadius:3,border:`1px solid ${C.gnBd}`,padding:"16px 20px",textAlign:"center"}}><div style={{fontSize:13,fontWeight:700,color:C.gn}}>ALL CHECKPOINTS SATISFIED</div></div>}
</div>)}</div>)}

/* METHODOLOGY */
function Pg2(){const[op,setOp]=useState(null);return(
<div style={{maxWidth:840,margin:"0 auto",padding:"28px 24px 40px"}}>
<span style={{fontSize:9,fontWeight:700,letterSpacing:2,color:C.br}}>METHODOLOGY & SOURCES</span>
<h1 style={{fontSize:22,fontWeight:700,color:C.wh,marginTop:4,marginBottom:6}}>Regulatory Foundations</h1>
<p style={{fontSize:12,color:C.txM,lineHeight:1.7,maxWidth:560,marginBottom:24}}>Every checkpoint traces to published guidance, enforcement actions, or supervisory data. No checkpoint exists without a verifiable source.</p>

<div style={{background:C.cd,borderRadius:3,border:`1px solid ${C.bd}`,overflow:"hidden",marginBottom:20}}>
<div style={{padding:"8px 14px",borderBottom:`1px solid ${C.bd}`}}><span style={{fontSize:9,fontWeight:700,color:C.txD,letterSpacing:1}}>PRIMARY SOURCES</span></div>
{[["OCC","Comptroller's Handbook","Rating Credit Risk (2001/2012), Loan Portfolio Mgmt (1998), Leveraged Lending (2008), CRE (2022)"],
["FDIC","Examination Data","Supervisory Trends: MRBA analysis of 3,400+ exams. Risk Review (2024/2025)"],
["FRB","SR Letters","SR 98-25 (Credit Risk), SR 21-19 (Archegos), SR 16-11 (Risk Mgmt), SR 95-51"],
["ENFRC","Enforcement Actions","OCC Consent Orders (FSGBank, Alliance Bank), SNC Appeals (Q1 2018, Q3 2021, Q3 2022)"],
["INTAG","Interagency Standards","Appraisal Guidelines (2010), Classification Standards (BC-127), ASC 326, CRE Guidance (2006)"]
].map(([cd,ti,d],i)=>(
<div key={i} style={{display:"flex",gap:10,padding:"10px 14px",borderBottom:`1px solid ${C.bd}`,background:i%2?C.sf:"transparent"}}>
<span style={{fontFamily:mono,fontSize:9,fontWeight:700,color:C.br,minWidth:36}}>{cd}</span>
<div><div style={{fontSize:11,fontWeight:600,color:C.wh}}>{ti}</div><div style={{fontSize:10,color:C.txM,marginTop:1}}>{d}</div></div></div>))}</div>

<div style={{background:C.amB,borderRadius:3,border:`1px solid ${C.amBd}`,padding:"10px 14px",marginBottom:24}}>
<span style={{fontSize:9,fontWeight:700,color:C.am,letterSpacing:.5}}>KEY FINDING</span>
<span style={{fontSize:10,color:C.am,marginLeft:8}}>FDIC: 69% of MRBAs cite loan deficiencies. 75%+ target credit administration.</span></div>

<div style={{display:"grid",gridTemplateColumns:"repeat(3,1fr)",gap:1,background:C.bd,borderRadius:3,overflow:"hidden",marginBottom:28}}>
{[{ti:1,d:"Cited in 60%+ of exams. Highest weight."},{ti:2,d:"Cited in 30–60%. Frequent in targeted reviews."},{ti:3,d:"Growing focus. Increasingly expected."}].map(x=>(
<div key={x.ti} style={{background:C.cd,padding:"12px 14px"}}><Bd ti={x.ti}/><p style={{fontSize:10,color:C.txM,marginTop:6,lineHeight:1.5}}>{x.d}</p></div>))}</div>

<div style={{fontSize:9,fontWeight:700,color:C.txD,letterSpacing:1,marginBottom:10}}>ALL {S.length} CATEGORIES · {TC} CHECKPOINTS</div>
{S.map(sec=>{const io=op===sec.id;return(
<div key={sec.id} style={{background:C.cd,borderRadius:3,border:`1px solid ${io?C.bdL:C.bd}`,marginBottom:5,overflow:"hidden"}}>
<button onClick={()=>setOp(io?null:sec.id)} style={{width:"100%",padding:"12px 14px",display:"flex",alignItems:"center",gap:10,textAlign:"left"}}>
<span style={{fontFamily:mono,fontSize:10,fontWeight:700,color:C.br,minWidth:22}}>{sec.c}</span>
<div style={{flex:1}}><div style={{display:"flex",alignItems:"center",gap:6}}><span style={{fontSize:12,fontWeight:600,color:C.wh}}>{sec.t}</span><Bd ti={sec.ti}/><span style={{fontSize:9,color:C.txD}}>{sec.ch.length}</span></div>
<div style={{fontSize:10,color:C.txD,marginTop:2}}>{sec.rg}</div></div>
<span style={{color:C.txD,fontSize:10}}>{io?"▾":"▸"}</span></button>
{io&&(<div style={{padding:"0 14px 14px 46px",borderTop:`1px solid ${C.bd}`}}>
<div style={{background:C.sf,borderRadius:3,padding:"10px 12px",marginTop:10,marginBottom:10,border:`1px solid ${C.bd}`}}>
<div style={{fontSize:8,fontWeight:700,color:C.br,letterSpacing:1,marginBottom:3}}>REGULATORY SOURCE</div>
<p style={{fontSize:10,color:C.txM,lineHeight:1.6,margin:0}}>{sec.sr}</p></div>
<div style={{background:C.sf,borderRadius:3,padding:"10px 12px",marginBottom:10,border:`1px solid ${C.bd}`}}>
<div style={{fontSize:8,fontWeight:700,color:C.txD,letterSpacing:1,marginBottom:3}}>EXAMINER FOCUS</div>
<p style={{fontSize:10,color:C.txM,lineHeight:1.6,margin:0}}>{sec.w}</p></div>
<div style={{fontSize:8,fontWeight:700,color:C.txD,letterSpacing:1,marginBottom:4}}>CHECKPOINTS</div>
{sec.ch.map(cp=>(
<div key={cp.l} style={{padding:"5px 0",borderTop:`1px solid ${C.bd}`}}>
<span style={{fontSize:11,color:C.tx}}>{cp.l}</span><br/>
<span style={{fontSize:8,color:C.txD}}>Weight: {"●".repeat(cp.wt)}{"○".repeat(3-cp.wt)} · {cp.kw.slice(0,3).join(", ")}</span></div>))}</div>)}</div>)})}

<div style={{marginTop:20,padding:"10px 14px",background:C.sf,borderRadius:3,border:`1px solid ${C.bd}`}}>
<p style={{fontSize:9,color:C.txD,lineHeight:1.6}}><strong style={{color:C.txM}}>Disclaimer:</strong> CRegul performs keyword-based detection against published regulatory guidance. Not legal advice. Does not substitute professional review. Citations reference publicly available documents as of March 2026.</p></div>
</div>)}

/* APP */
function App(){
const[pg,setPg]=useState(window.location.hash.replace("#/","")||"");
const go=useCallback(p=>{window.location.hash="#/"+p;setPg(p);window.scrollTo({top:0,behavior:"smooth"})},[]);
useEffect(()=>{const h=()=>setPg(window.location.hash.replace("#/","")||"");window.addEventListener("hashchange",h);return()=>window.removeEventListener("hashchange",h)},[]);
return(<div style={{minHeight:"100vh",background:C.bg}}>
<Nav p={pg} go={go}/>
{pg===""&&<Pg0 go={go}/>}{pg==="tool"&&<Pg1 go={go}/>}{pg==="methodology"&&<Pg2/>}
<div style={{borderTop:`1px solid ${C.bd}`,padding:"16px 24px",display:"flex",justifyContent:"space-between",marginTop:40}}>
<span style={{fontSize:9,color:C.txD}}>CRegul · Credit Review Regulatory Intelligence</span>
<span style={{fontSize:9,color:C.txD,fontFamily:mono}}>OCC · FDIC · FRB</span></div>
</div>)}

ReactDOM.createRoot(document.getElementById('root')).render(React.createElement(App));
</script>
</body>
</html>
